{
  "expo": {
    "name": "Kashremit Payments",
    "slug": "Kashremit",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "KASHREMIT",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "buildNumber": "1",
      "bundleIdentifier": "com.kashremitpayments.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Kashremit needs Face ID to log you in securely and quickly.",
        "NSCameraUsageDescription": "Kashremit needs camera access to allow you to take photos for your profile picture and upload necessary KYC documents.",
        "NSPhotoLibraryUsageDescription": "Kashremit needs access to your photo library so you can select and upload profile pictures and KYC documents.",
        "NSPhotoLibraryAddUsageDescription": "Kashremit needs permission to save downloaded transaction receipts to your photo library."
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "permissions": [
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.kashremitpayments.app",
      "versionCode": 11
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "usesCleartextTraffic": false,
            "enableProguardInReleaseBuilds": true
          }
        }
      ],
      "expo-secure-store",

      [
        "expo-document-picker",
        {}
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Kashremit to access your photos to upload documents.",
          "cameraPermission": "Allow Kashremit to access your camera to scan documents."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "owner": "nateshkumar",
    "runtimeVersion": "1.0.1",
    "updates": {
      "url": "https://u.expo.dev/1c418fb4-d485-451d-abfb-15487e0a2730",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "1c418fb4-d485-451d-abfb-15487e0a2730"
      }
    }
  }
}
