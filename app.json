{
  "expo": {
    "name": "Kashremit",
    "slug": "Kashremit",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "KASHREMIT",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "buildNumber": "4",
      "bundleIdentifier": "com.kashremit.kashremit",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Kashremit needs Face ID to log you in securely and quickly.",
        "NSCameraUsageDescription": "Kashremit needs camera access to allow you to take photos for your profile picture and upload necessary KYC documents.",
        "NSPhotoLibraryUsageDescription": "Kashremit needs access to your photo library so you can select and upload profile pictures and KYC documents.",
        "NSPhotoLibraryAddUsageDescription": "Kashremit needs permission to save downloaded transaction receipts to your photo library."
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.kashremit.kashremit",
      "versionCode": 4
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-build-properties",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false,
            "enableProguardInReleaseBuilds": true
          }
        }
      ],
      "expo-secure-store"
    ],
    "owner": "nateshkumar",
    "runtimeVersion": "1.0.1",
    "updates": {
      "url": "https://u.expo.dev/1c418fb4-d485-451d-abfb-15487e0a2730",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "1c418fb4-d485-451d-abfb-15487e0a2730"
      }
    }
  }
}
